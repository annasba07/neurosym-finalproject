GROQ_API_KEY=your_groq_api_key_here

# Optional: uncomment to use a different LLM provider
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# Neo4j AuraDB — required by knowledge_graph_agent
NEO4J_URI=neo4j+s://your_host.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Optional: OpenRouter (used by alex rules agent LLM comparison)
# OPENROUTER_API_KEY=your_openrouter_key
