{
  "_comment": "Golden dataset for interpretation_agent evaluation. 'scenarios' are multi-turn conversations from the course PDF. 'targeted_cases' are single-turn stress tests with explicit prior_state to isolate specific failure modes. In expected_extracted_fields, null means 'should not be set from this message' (non-overwrite check).",
  "required_fields_priority": ["alert", "breathing_issues", "temperature_f", "urination_8h", "drinking", "current_medication"],

  "targeted_cases": [
    {
      "id": "tc_01",
      "category": "implied-field",
      "description": "alert='no' implied by behavior, not stated directly",
      "prior_state": {
        "age_months": 48, "fever": "yes", "vomiting": null, "temperature_f": null,
        "alert": null, "breathing_issues": null, "urination_8h": null,
        "drinking": null, "current_medication": null, "medication_last_dose": null,
        "rash": null, "neck_pain": null, "fever_duration_days": null
      },
      "caregiver_message": "He's just staring at the wall and won't look at me when I call his name.",
      "expected_extracted_fields": {
        "alert": "no",
        "temperature_f": null, "breathing_issues": null, "urination_8h": null,
        "drinking": null, "current_medication": null, "medication_last_dose": null,
        "fever": null, "vomiting": null, "rash": null, "neck_pain": null,
        "age_months": null, "fever_duration_days": null
      },
      "expected_cumulative_state": {
        "age_months": 48, "fever": "yes", "vomiting": null, "temperature_f": null,
        "alert": "no", "breathing_issues": null, "urination_8h": null,
        "drinking": null, "current_medication": null, "medication_last_dose": null,
        "rash": null, "neck_pain": null, "fever_duration_days": null
      },
      "expected_is_complete": false,
      "notes": "Unresponsiveness is described behaviorally, not with the word 'responding'. Model must infer alert='no'. Weak models may leave it null waiting for explicit wording."
    },
    {
