        "rash": null, "neck_pain": null, "fever_duration_days": null
      },
      "caregiver_message": "She's barely sipping, just a few drops of water here and there, but she's not refusing it.",
      "expected_extracted_fields": {
        "drinking": "some",
        "temperature_f": null, "alert": null, "breathing_issues": null,
        "urination_8h": null, "current_medication": null, "medication_last_dose": null,
        "fever": null, "vomiting": null, "rash": null, "neck_pain": null,
        "age_months": null, "fever_duration_days": null
