      "expected_cumulative_state": {
        "age_months": 36, "fever": "yes", "vomiting": "once", "temperature_f": 102.1,
        "alert": "yes", "breathing_issues": "no", "urination_8h": null,
        "drinking": "some", "current_medication": null, "medication_last_dose": null,
        "rash": null, "neck_pain": null, "fever_duration_days": null
      },
      "expected_is_complete": false,
      "notes": "Minimal but present fluid intake → 'some', not 'no'. 'not refusing it' is the key phrase. A model that maps any low intake to 'no' will fail this."
